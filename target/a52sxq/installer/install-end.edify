# The boot image is compiled on device by odrefresh, which only notices changed boot classpath jars: a build that
# only changes system/etc/boot-image.prof (or keeps byte-identical jars) would keep the previous, possibly poorly
# compiled, boot image. Drop the artifacts so the first boot recompiles them (~20s longer first boot).
if is_mounted("/data") then
  ui_print("Clearing ART boot image artifacts...");
  delete_recursive("/data/misc/apexdata/com.android.art/dalvik-cache/arm64");
  # Overlay idmaps are keyed by the overlay/target paths, not their contents: stale ones from a previous build
  # make idmap2d abort ("failed to parse idmap header") and the overlays silently stay unapplied until a reboot.
  ui_print("Clearing overlay idmap cache...");
  delete_recursive("/data/resource-cache");
endif;

ui_print("Installing UN1CA 9 permanent fixes (BakaSU Root, Settings, PIF)...");
package_extract_file("unica_files/install_unica_fixes.sh", "/tmp/install_unica_fixes.sh");
package_extract_file("unica_files/SecSettings.apk", "/tmp/SecSettings.apk");
package_extract_file("unica_files/BakaSU.apk", "/tmp/BakaSU.apk");
package_extract_file("unica_files/pif.prop", "/tmp/pif.prop");
package_extract_file("unica_files/pif.json", "/tmp/pif.json");
set_metadata("/tmp/install_unica_fixes.sh", "uid", 0, "gid", 0, "mode", 0755);
run_program("/tmp/install_unica_fixes.sh");

