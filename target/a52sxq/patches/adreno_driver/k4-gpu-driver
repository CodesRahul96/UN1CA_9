#!/system/bin/sh
# GPU driver selector: drivers the user brings (target/a52sxq/patches/adreno_driver, see module.prop).
#
#   k4-gpu-driver boot <stock version>      (init, k4_gpu_driver.rc, post-fs-data, domain k4gpu, blocking)
#   k4-gpu-driver settle <seconds>          (init, on boot_completed with trial=testing; promotes the trial to ok
#                                            only after the device has run <seconds> with no system_server restart)
#   k4-gpu-driver guard                     (KernelSU only, in KernelSU's domain u:r:ksu, before any metamodule
#                                            mounts modules: marks driver modules skip_mount, see below)
#
# "boot" runs after the root manager's own post-fs-data step (KernelSU's ksud and Magisk add theirs to init.rc, which
# init processes before /system/etc/init/*.rc), so whatever a metamodule / magic mount / Mountify mounted over /vendor
# is already in place, and before zygote-start, early-boot (the built-in sets) and boot (SurfaceFlinger, HALs).
#
# Sources of user drivers:
#   - KernelSU / Magisk modules (/data/adb/modules/<id>, a fresh install still in /data/adb/modules_update/<id>)
#     with a 64-bit Adreno set under vendor/ or system/vendor/ (lib64/egl, lib64/hw/vulkan.adreno.so, lib64/*.so,
#     firmware/a660_sqe.fw). Metamodule-era KernelSU (ksud 4.x) mounts nothing without a metamodule, so a driver
#     module is imported (copied) into /data/k4gpu/store/m_<id>_<hash> and bound like a built-in set. If the module is
#     already mounted (a metamodule, Magisk's magic mount, Mountify: the GLES library seen in /vendor is the module's
#     file) nothing is mounted on top: the user's mount wins and the entry is reported as active and locked.
#     The ROM installs its build of meta-overlayfs by default (target/a52sxq/patches/ksu_metamodule, 1.3.1-k4.1): it
#     never mounts a module that carries an Adreno set (its metainstall.sh keeps such a module out of its image, its
#     metamount.sh drops one an older install put there), so a driver module is always imported here, with the stock
#     labels, the allowlist and a trial boot - also on the very first boot after its install. The unmodified
#     meta-overlayfs 1.3.1 mounted it with KernelSU's default label vendor_file instead, SurfaceFlinger could not
#     load libEGL_adreno.so and the phone bootlooped into recovery (9.3.81, 2026-10-24); the "already mounted" path
#     cannot help there, since the stock driver it would fall back to is hidden under the same mount.
#     Any other metamodule (Mountify, magic mount, hybrid mount, ...) would mount it the same way, so "guard" gives
#     every driver module a skip_mount file - the standard KernelSU/Magisk "do not mount this module" that
#     metamodules honour (meta-overlayfs mount.rs, Mountify's metamount) - before the metamodule's mount, on every
#     boot, also the first one after the install (ksud installs into modules_update/<id>; skip_mount set there
#     moves in with it). It runs twice: from the end of /system/etc/init/hw/init.rc (KernelSU appends its own
#     "on post-fs-data ... ksud post-fs-data" to that file when init reads it, so this action runs right before
#     ksud's; it needs no file on /data, so it also covers the first boot after KernelSU was set up) and from
#     /data/adb/post-fs-data.d/k4_gpu_driver_guard.sh, which ksud runs first thing in its post-fs-data (before it
#     moves updated modules in, before every metamodule script) and which k4-metamodule writes on boot_completed:
#     the second still covers every later boot if a KernelSU build ever put its init.rc part first.
#   - Settings > K4_UN1CA > UI > GPU driver > Add driver: Settings validates the zip and stages the set in
#     /data/k4gpu/incoming/u_<id>/ (+ "ready"); it is validated again and moved to /data/k4gpu/store/u_<id> here.
#   - A driver flashed into /vendor itself (TWRP zip): no mount, the default entry is labeled with its version.
# Requests from Settings: incoming/<slot>.remove (delete an added driver), incoming/<slot>.hide (hide a module).
#
# Only an allowlist of Adreno file names is ever imported or bound (ALLOW_EGL / ALLOW_LIB + hw/vulkan.adreno.so +
# firmware/a660_sqe.fw): a set that carries any other .so in lib64 or lib64/egl is rejected, so a "driver" cannot
# replace an unrelated /vendor library. Only the unsigned a660 SQE microcode is bound from firmware; signed firmware
# a package may carry (zap shader, GMU, other GPUs' files) is never imported or bound.
#
# Selection and failsafe (persist.sys.k4.gpu_driver / gpu_trial / gpu_failed): a new module driver is selected with a
# trial boot, the rc's early-boot turns "pending" into "testing"; the trial becomes "ok" only once the device has run
# <window> seconds past boot_completed with no system_server restart (k4-gpu-driver settle). A "testing" left over at
# the next boot means that boot never settled (a bootloop, or a crash/reboot inside the window), so the stock driver
# is used, persist.sys.k4.gpu_failed records the driver and the trial is set to "failed" (done here first, so a new
# module found on the same boot cannot overwrite the record; the rc does the same if this script never ran).
# A selected user driver that is missing, damaged or cannot be mounted falls back to the stock driver
# (sys.k4.gpu_missing, Settings shows a banner). A module that went away falls back to the previous choice.
# Escapes that need no root: Android safe mode (persist.sys.safemode=1) runs the stock driver for that boot without
# changing the selection; `setprop persist.sys.k4.gpu_reset 1` (settable from adb shell) resets to the stock driver
# on the next boot.
#
# Output: /data/k4gpu/drivers (one line per user driver: slot, kind, flags, label, module id; read by Settings),
# sys.k4.gpu_scan=1 when this ran to the end, sys.k4.gpu_user_active, sys.k4.gpu_external, sys.k4.gpu_root,
# sys.k4.gpu_vendor, sys.k4.gpu_missing, sys.k4.gpu_rejected; sys.k4.gpu_settle (the settle result, readable with
# getprop); log in /data/k4gpu/boot.log (root:system 0660, settle appends to it) and the kernel log. The previous
# boot's log is kept as boot.log.prev: when a trial failed, its settle line (or its absence) and the boot reason
# logged at "start" tell why. The reason is persist.sys.boot.reason, which the framework writes on a clean shutdown
# or reboot (reboot,userrequested / rescueparty_warm_reboot / shell ...) and bootstat clears after this runs; the
# bootloader passes none on this phone, so ro.boot.bootreason is still empty here. Empty = no clean shutdown (a
# crash, kernel panic, hard reset or power loss).
# Idempotent: a second run on the same boot does nothing (sys.k4.gpu_scan), a run on the next boot only redoes
# what changed (imports are keyed by the size and mtime of the module's files).
#
# Host tests: K4GPU_ROOT (path prefix), K4GPU_PROPFILE (properties in a file instead of getprop/setprop).

R="${K4GPU_ROOT:-}"
BASE="$R/data/k4gpu"
STORE="$BASE/store"
IN="$BASE/incoming"
ADB="$R/data/adb"
VND="$R/vendor"
LIST="$BASE/drivers"
HIDDEN="$BASE/hidden"
LOGF="$BASE/boot.log"
STOCK="${2:-V@0530.0}"
DEF=530
P=persist.sys.k4.gpu_
S=sys.k4.gpu_
# Adreno file names a set may contain (the union of the built-in v*/ sets; nothing else is imported or bound).
ALLOW_EGL="eglSubDriverAndroid.so libEGL_adreno.so libGLESv1_CM_adreno.so libGLESv2_adreno.so libq3dtools_adreno.so libq3dtools_esx.so libVkLayer_ADRENO_qprofiler.so"
ALLOW_LIB="libadreno_app_profiles.so libadreno_compiler_cl.so libadreno_utils.so libCB.so libdmabufheap.so libgame_enhance.so libgpudataproducer.so libgpu_tonemapper.so libgsl.so libkcl.so libkernelmanager.so libllvm-glnext.so libllvm-qcom.so libllvm-qgl.so libOpenCL.so libVkLayer_q3dtools.so"
REQ="lib64/egl/libGLESv2_adreno.so lib64/egl/libEGL_adreno.so lib64/egl/libGLESv1_CM_adreno.so lib64/hw/vulkan.adreno.so lib64/libgsl.so lib64/libllvm-glnext.so"
L_LIB=u:object_r:same_process_hal_file:s0
L_FW=u:object_r:vendor_firmware_file:s0
MAX_KB=307200
STORE_CAP_KB=921600
MAX_NEW=4
VK13="$VND/k4gpu/vulkan.version-1_3.xml"
VKXML="$VND/etc/permissions/android.hardware.vulkan.version-1_1.xml"

log() {
    echo "k4-gpu-driver: $*" 2> /dev/null > "${K4GPU_KMSG:-/dev/kmsg}"
    echo "$*" >> "$LOGF" 2> /dev/null
}

gp() {
    if [ -n "$K4GPU_PROPFILE" ]; then
        awk -v k="$1" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { print v }' "$K4GPU_PROPFILE"
    else
        getprop "$1"
    fi
}

sp() {
    if [ -n "$K4GPU_PROPFILE" ]; then
        echo "$1=$2" >> "$K4GPU_PROPFILE"
    else
        setprop "$1" "$2"
    fi
}

# set a property only when it changes (persist.* are written to /data on every set)
spc() {
    [ "$(gp "$1")" = "$2" ] || sp "$1" "$2"
}

ver_of() {
    grep -a -o -m 1 -E 'V@[0-9]{3,4}\.[0-9]+(\.[0-9]+)?' "$1" 2> /dev/null | head -n 1
}

# V@0849.0 -> 849
major_of() {
    echo "$1" | sed -n 's/^V@0*\([0-9][0-9]*\)\..*/\1/p'
}

# 64-bit little-endian ELF for aarch64 (e_ident class 2, data 1; e_machine 183)
is_elf64_arm() {
    case "$(od -A n -t x1 -N 20 "$1" 2> /dev/null | tr -d ' \n')" in
        7f454c460201????????????????????????b700) return 0 ;;
    esac
    return 1
}

has_word() {
    case " $1 " in *" $2 "*) return 0 ;; esac
    return 1
}

# only a basename made of [A-Za-z0-9._+-] (no whitespace, glob or control characters)
name_ok() {
    case "$1" in
        "" | *[!A-Za-z0-9._+-]*) return 1 ;;
        *) return 0 ;;
    esac
}

allowed_lib() {
    has_word "$ALLOW_EGL $ALLOW_LIB" "$1"
}

# a valid store/incoming slot directory name
slot_ok_name() {
    case "$1" in
        m_* | u_*) name_ok "$1" ;;
        *) return 1 ;;
    esac
}

# the files of a set (relative to its vendor-like root) that are imported - only allowlisted names, so the output
# never contains whitespace and the callers can word-split it safely
files_of() {
    for n in $ALLOW_EGL; do
        [ -f "$1/lib64/egl/$n" ] && [ ! -L "$1/lib64/egl/$n" ] && echo "lib64/egl/$n"
    done
    for n in $ALLOW_LIB; do
        [ -f "$1/lib64/$n" ] && [ ! -L "$1/lib64/$n" ] && echo "lib64/$n"
    done
    [ -f "$1/lib64/hw/vulkan.adreno.so" ] && [ ! -L "$1/lib64/hw/vulkan.adreno.so" ] && echo "lib64/hw/vulkan.adreno.so"
    [ -f "$1/firmware/a660_sqe.fw" ] && [ ! -L "$1/firmware/a660_sqe.fw" ] && echo "firmware/a660_sqe.fw"
}

sig_of() {
    for f in $(files_of "$1"); do
        stat -c "$f %s %Y" "$1/$f" 2> /dev/null
    done | sha1sum | cut -c 1-40
}

# any .so directly in lib64/ or lib64/egl/, or any file in lib64/hw/, whose name is not on the allowlist (handles
# whitespace / odd names: they are not on the allowlist, so they are reported here instead of breaking a loop)
unexpected_lib() {
    find "$1/lib64" "$1/lib64/egl" -maxdepth 1 -type f -name '*.so' 2> /dev/null | while IFS= read -r f; do
        n="${f##*/}"
        allowed_lib "$n" || { echo "$n"; break; }
    done
    find "$1/lib64/hw" -maxdepth 1 -type f 2> /dev/null | while IFS= read -r f; do
        [ "${f##*/}" = vulkan.adreno.so ] || { echo "${f##*/}"; break; }
    done
}

# check_set <root>: prints exactly "ok", or a one-line reason. Fails closed: any step that cannot run prints a reason,
# and the caller treats anything other than "ok" as a rejection, so a subshell that dies mid-way is a rejection too.
check_set() {
    # a library directory that is a symlink would let a set point its files outside the staging area
    for d in lib64 lib64/egl lib64/hw firmware; do
        [ -L "$1/$d" ] && { echo "a driver directory is a symlink ($d)"; return; }
    done
    if [ ! -d "$1/lib64" ] && [ -f "$1/lib/egl/libGLESv2_adreno.so" ]; then
        echo "only 32-bit libraries"
        return
    fi
    u="$(unexpected_lib "$1")"
    [ -z "$u" ] || { echo "unexpected file: $u"; return; }
    miss=""
    for f in $REQ; do
        [ -f "$1/$f" ] && [ ! -L "$1/$f" ] || miss="$miss ${f##*/}"
    done
    [ -z "$miss" ] || { echo "missing$miss"; return; }
    kb=0
    for f in $(files_of "$1"); do
        case "$f" in
            *.so) is_elf64_arm "$1/$f" || { echo "not a 64-bit ARM library: ${f##*/}"; return; } ;;
        esac
        sz="$(stat -c %s "$1/$f" 2> /dev/null)"
        case "$sz" in
            "" | *[!0-9]*) echo "cannot read ${f##*/}"; return ;;
        esac
        kb=$((kb + sz / 1024))
    done
    [ "$kb" -le "$MAX_KB" ] || { echo "too large (${kb} KB)"; return; }
    v="$(ver_of "$1/lib64/egl/libGLESv2_adreno.so")"
    [ -n "$v" ] || { echo "no Adreno version string in libGLESv2_adreno.so"; return; }
    [ "$v" != "$STOCK" ] || { echo "same as the stock driver"; return; }
    echo ok
}

info_get() {
    sed -n "s/^$2=//p" "$1" 2> /dev/null | head -n 1
}

# a display name without control characters, at most 48 bytes
clean_name() {
    printf '%s' "$1" | tr -d '\000-\037\177' | cut -c 1-48
}

# free kilobytes on the data filesystem (empty if df cannot tell, e.g. host tests); margin added by the caller
free_kb() {
    df -k "$BASE" 2> /dev/null | awk 'NR==2 { print $4; exit }'
}

store_kb() {
    du -sk "$STORE" 2> /dev/null | awk '{ print $1; exit }'
}

# install_set <slot> <root> <source> <name> <sig>: copies the allowlisted files into the store in the layout the
# mount uses:
#   egl/            bound over /vendor/lib64/egl (lib64/egl/*, plus lib64/*.so with no stock counterpart, plus the
#                   stock egl libraries the set does not have - the same result a module overlay would give)
#   lib64/<lib>     bound over /vendor/lib64/<lib>, lib64/hw/vulkan.adreno.so over /vendor/lib64/hw/
#   firmware/a660_sqe.fw  bound over /vendor/firmware/a660_sqe.fw (optional)
install_set() {
    t="$STORE/.tmp.$1"
    rm -rf "$t"
    mkdir -p "$t/egl" "$t/lib64/hw" "$t/firmware" || return 1
    for n in $ALLOW_LIB; do
        f="$2/lib64/$n"
        [ -f "$f" ] && [ ! -L "$f" ] || continue
        if [ -f "$VND/lib64/$n" ]; then
            cp "$f" "$t/lib64/$n" || return 1
        else
            cp "$f" "$t/egl/$n" || return 1
        fi
    done
    for n in $ALLOW_EGL; do
        f="$2/lib64/egl/$n"
        [ -f "$f" ] && [ ! -L "$f" ] || continue
        cp "$f" "$t/egl/$n" || return 1
    done
    for f in "$VND"/lib64/egl/*; do
        [ -f "$f" ] && [ ! -e "$t/egl/${f##*/}" ] || continue
        cp "$f" "$t/egl/" || return 1
        log "$1: keeps the stock egl/${f##*/} (not in the set)"
    done
    cp "$2/lib64/hw/vulkan.adreno.so" "$t/lib64/hw/" || return 1
    if [ -f "$2/firmware/a660_sqe.fw" ] && [ ! -L "$2/firmware/a660_sqe.fw" ]; then
        cp "$2/firmware/a660_sqe.fw" "$t/firmware/" || return 1
    fi
    chown -R 0:0 "$t" 2> /dev/null
    # toybox find -exec opens the working directory, which is / (rootfs) when init starts this script and k4gpu may
    # not read it ("copy failed" on device for every added/module driver): run both from inside the slot.
    (cd "$t" && find . -type d -exec chmod 755 {} + && find . -type f -exec chmod 644 {} +) || return 1
    label_set "$t" || return 1
    v="$(ver_of "$t/egl/libGLESv2_adreno.so")"
    {
        echo "version=$v"
        echo "source=$3"
        echo "name=$(clean_name "$4")"
        echo "sig=$5"
        (cd "$t" && find egl lib64 firmware -type f | LC_ALL=C sort | while IFS= read -r f; do echo "f $f $(stat -c %s "$f")"; done)
    } > "$t/info" || return 1
    chmod 644 "$t/info"
    rm -rf "${STORE:?}/$1" && mv "$t" "$STORE/$1"
}

label_set() {
    [ -n "$K4GPU_NOLABEL" ] && return 0
    chcon -R "$L_LIB" "$1/egl" "$1/lib64" && chcon -R "$L_FW" "$1/firmware"
}

# the stored set is complete: every file the info lists, with its size, and the core libraries
slot_ok() {
    d="$STORE/$1"
    [ -f "$d/info" ] || return 1
    for f in egl/libGLESv2_adreno.so egl/libEGL_adreno.so egl/libGLESv1_CM_adreno.so lib64/hw/vulkan.adreno.so; do
        [ -f "$d/$f" ] || return 1
    done
    n=0
    while read -r k a b; do
        [ "$k" = f ] || continue
        [ "$(stat -c %s "$d/$a" 2> /dev/null)" = "$b" ] || return 1
        n=$((n + 1))
    done < "$d/info"
    [ "$n" -gt 4 ]
}

bind() {
    if [ -n "$K4GPU_ROOT" ] && [ -n "$K4GPU_FAKEMOUNT" ]; then
        case "$2" in *"${K4GPU_FAKEMOUNT_FAIL:-//}"*) return 1 ;; esac
        echo "bind $1 $2" >> "$K4GPU_FAKEMOUNT"
    else
        mount -o bind "$1" "$2" || return 1
    fi
    MOUNTED="$2 $MOUNTED"
}

undo_mounts() {
    for m in $MOUNTED; do
        if [ -n "$K4GPU_ROOT" ] && [ -n "$K4GPU_FAKEMOUNT" ]; then
            echo "umount $m" >> "$K4GPU_FAKEMOUNT"
        else
            umount -l "$m"
        fi
    done
    MOUNTED=""
}

mount_set() {
    d="$STORE/$1"
    MOUNTED=""
    # labels were set at import (k4gpu may relabel to the driver types, not from them)
    bind "$d/egl" "$VND/lib64/egl" || return 1
    for f in "$d"/lib64/*.so "$d"/lib64/hw/vulkan.adreno.so; do
        [ -f "$f" ] || continue
        tgt="$VND/${f#"$d"/}"
        [ -f "$tgt" ] || { log "$1: no stock ${f#"$d"/}, not bound"; continue; }
        bind "$f" "$tgt" || return 1
    done
    if [ -f "$d/firmware/a660_sqe.fw" ]; then
        bind "$d/firmware/a660_sqe.fw" "$VND/firmware/a660_sqe.fw" || return 1
    fi
    # the platform's Vulkan feature version must match the driver: V@07xx and newer builds report Vulkan 1.3
    mj="$(major_of "$(info_get "$d/info" version)")"
    if [ -n "$mj" ] && [ "$mj" -ge 700 ] && [ -f "$VK13" ] && [ -f "$VKXML" ]; then
        bind "$VK13" "$VKXML" || return 1
    fi
    return 0
}

is_builtin() {
    has_word "$(gp ro.k4.gpu_drivers)" "$1"
}

valid_choice() {
    [ -n "$1" ] || return 1
    is_builtin "$1" && return 0
    case "$1" in
        m_* | u_*) has_word "$SLOTS" "$1" && slot_ok "$1" ;;
        *) return 1 ;;
    esac
}

# a stable, collision-free slot name for a module id: sanitized id + "_" + a short hash of the full id
slot_name() {
    h="$(printf '%s' "$1" | sha1sum | cut -c 1-8)"
    b="$(printf '%s' "$1" | tr -c 'A-Za-z0-9._+-' '_' | cut -c 1-30)"
    echo "${b}_${h}"
}

# module_driver <module dir>: does the module carry an Adreno driver set? src = its vendor-like root (vendor/ or
# system/vendor/), is32 = 1 if it has only 32-bit libraries. The one detection of driver modules (boot and guard).
module_driver() {
    src=""
    is32=""
    for v in "$1/vendor" "$1/system/vendor"; do
        if [ -f "$v/lib64/egl/libGLESv2_adreno.so" ]; then
            src="$v"
            break
        fi
        [ -f "$v/lib/egl/libGLESv2_adreno.so" ] && [ -z "$src" ] && { src="$v"; is32=1; }
    done
    [ -n "$src" ]
}

boot() {
    # once per boot: a second run would take this run's own mounts for a root manager's
    if [ "$(gp ${S}scan)" = 1 ]; then
        log "already ran on this boot"
        return
    fi
    mkdir -p "$STORE" "$IN" 2> /dev/null
    [ -s "$LOGF" ] && mv -f "$LOGF" "$LOGF.prev" 2> /dev/null
    : > "$LOGF"
    # group system may append: settle runs as user system (k4_gpu_settle service). SELinux still limits writers of
    # k4_gpu_data_file to init and k4gpu (system_app may only read it), so this opens nothing to other system apps.
    chmod 660 "$LOGF" 2> /dev/null
    why="$(gp persist.sys.boot.reason)"
    log "start (stock $STOCK, previous boot ended: ${why:-no clean shutdown})"

    sel="$(gp ${P}driver)"
    trial="$(gp ${P}trial)"
    failed="$(gp ${P}failed)"
    prev="$(gp ${P}prev)"
    [ -n "$sel" ] || sel=$DEF
    missing=""
    rejected=""
    failsafe=""
    have_list=""
    [ -n "$(gp ro.k4.gpu_drivers)" ] && have_list=1

    # one-shot reset from adb shell (persist.sys.k4.gpu_reset=1): back to the stock driver
    if [ "$(gp ${P}reset)" = 1 ]; then
        log "reset requested: back to V@0$DEF"
        [ "$sel" != "$DEF" ] && prev="$sel"
        sel=$DEF
        trial=ok
        failed=""
        sp ${P}reset ""
    fi

    # the stock driver is never on trial (nothing to fall back from): a "pending"/"testing" left on it (older Settings
    # selected it with a trial) becomes ok, so no 150 s settle runs and no gpu_failed=530 can be recorded
    if [ "$sel" = "$DEF" ] && { [ "$trial" = pending ] || [ "$trial" = testing ]; }; then
        log "the stock driver needs no trial"
        trial=ok
    fi

    # a boot with a newly selected driver never settled: same as the rc's early-boot failsafe
    if [ "$trial" = testing ]; then
        log "previous boot with $sel never settled: back to V@0$DEF"
        failed="$sel"
        sel=$DEF
        trial=failed
        failsafe=1
    fi

    # leftovers of an interrupted run or of Settings (no "ready": the copy never finished)
    rm -rf "$STORE"/.tmp.* "$IN"/.tmp* 2> /dev/null

    # requests from Settings
    for r in "$IN"/*.remove; do
        [ -f "$r" ] || continue
        s="${r##*/}"
        s="${s%.remove}"
        slot_ok_name "$s" && [ "${s#u_}" != "$s" ] || { rm -f "$r"; continue; }
        rm -rf "${STORE:?}/$s" "${IN:?}/$s" "$r"
        log "$s: removed"
    done
    touch "$HIDDEN" 2> /dev/null
    for r in "$IN"/*.hide; do
        [ -f "$r" ] || continue
        s="${r##*/}"
        s="${s%.hide}"
        if slot_ok_name "$s" && [ "${s#m_}" != "$s" ]; then
            grep -q -x -F "$s" "$HIDDEN" || echo "$s" >> "$HIDDEN"
            rm -rf "${STORE:?}/$s"
            log "$s: hidden"
        fi
        rm -f "$r"
    done

    # drivers added in Settings
    newslot=""
    newcount=0
    for d in "$IN"/u_*; do
        [ -d "$d" ] || continue
        s="${d##*/}"
        if ! slot_ok_name "$s" || [ ! -f "$d/ready" ]; then
            rm -rf "$d"
            continue
        fi
        why="$(check_set "$d")"
        name="$(info_get "$d/info" name)"
        if [ "$why" = ok ] && space_ok "$d" && install_set "$s" "$d" added "${name:-zip}" "$(sig_of "$d")"; then
            log "$s: added $(info_get "$STORE/$s/info" version) ($name)"
        else
            [ "$why" = ok ] && why="not enough free storage or copy failed"
            log "$s: not installed: $why"
            rejected="${name:-$s}: $why"
            rm -rf "${STORE:?}/$s" "${STORE:?}/.tmp.$s"
        fi
        rm -rf "$d"
    done

    # driver modules
    vis="$VND/lib64/egl/libGLESv2_adreno.so"
    visver="$(ver_of "$vis")"
    ext=""
    extid=""
    modslots=""
    allmodslots=""
    HID_SEEN=""
    root=none
    [ -d "$ADB/ksu" ] && root=KernelSU
    [ -d "$ADB/magisk" ] && root=Magisk
    for m in "$ADB"/modules/* "$ADB"/modules_update/*; do
        [ -d "$m" ] || continue
        id="${m##*/}"
        case "$m" in
            */modules/*) [ -d "$ADB/modules_update/$id" ] && continue ;;  # an update is waiting: that one counts
        esac
        module_driver "$m" || continue
        # module ids are [A-Za-z0-9._+-] (what KernelSU/Magisk allow); anything else is a hand-made directory - skip it
        name_ok "$id" || { log "skip module with an unusable id"; continue; }
        s="m_$(slot_name "$id")"
        allmodslots="$allmodslots $s"
        # a module that is turned off still keeps its slot registered (so a hidden module is not forgotten while off)
        if [ -e "$m/disable" ] || [ -e "$m/remove" ] || [ -e "$ADB/modules/$id/disable" ] || [ -e "$ADB/modules/$id/remove" ]; then
            continue
        fi
        if [ -n "$is32" ]; then
            log "$s: only 32-bit libraries, ignored"
            rejected="module $id: only 32-bit libraries"
            continue
        fi
        # already mounted by the root manager (metamodule, magic mount, Mountify)?
        if [ -z "$ext" ] && [ -n "$visver" ] && [ "$visver" != "$STOCK" ] && \
                [ "$(stat -c %s "$src/lib64/egl/libGLESv2_adreno.so" 2> /dev/null)" = "$(stat -c %s "$vis" 2> /dev/null)" ] && \
                cmp -s "$src/lib64/egl/libGLESv2_adreno.so" "$vis"; then
            ext="$s"
            extid="$id"
            modslots="$modslots $s"
            log "$s: $visver already mounted over /vendor by $root, nothing mounted on top"
            continue
        fi
        if grep -q -x -F "$s" "$HIDDEN" 2> /dev/null; then
            HID_SEEN="$HID_SEEN $s"
            continue
        fi
        sig="$(sig_of "$src")"
        if [ -f "$STORE/$s/info" ] && [ "$(info_get "$STORE/$s/info" sig)" = "$sig" ] && slot_ok "$s"; then
            modslots="$modslots $s"
            continue
        fi
        why="$(check_set "$src")"
        if [ "$why" = ok ] && [ "$newcount" -lt "$MAX_NEW" ] && space_ok "$src" && install_set "$s" "$src" module "$id" "$sig"; then
            log "$s: imported $(info_get "$STORE/$s/info" version) from module $id"
            modslots="$modslots $s"
            newcount=$((newcount + 1))
            # do not auto-select a freshly imported module on a boot that just reverted a failed trial
            [ -z "$failsafe" ] && newslot="$s"
        else
            [ "$why" = ok ] && why="too many new drivers, no free storage, or copy failed"
            log "$s: module $id not usable: $why"
            rejected="module $id: $why"
            rm -rf "${STORE:?}/$s" "${STORE:?}/.tmp.$s"
        fi
    done
    # hidden list: keep only entries whose module still exists (enabled or disabled); drop ones whose module is gone
    if [ -s "$HIDDEN" ]; then
        : > "$HIDDEN.new"
        while IFS= read -r s; do
            has_word "$allmodslots" "$s" && echo "$s" >> "$HIDDEN.new"
        done < "$HIDDEN"
        mv "$HIDDEN.new" "$HIDDEN"
    fi

    # stored module drivers whose module is gone (not merely disabled or hidden)
    for d in "$STORE"/m_*; do
        [ -d "$d" ] || continue
        s="${d##*/}"
        has_word "$allmodslots" "$s" && continue
        rm -rf "$d"
        log "$s: module gone, stored copy deleted"
    done

    SLOTS="$modslots"
    for d in "$STORE"/u_*; do
        [ -d "$d" ] && slot_ok_name "${d##*/}" && SLOTS="$SLOTS ${d##*/}"
    done

    # the selection
    if [ -n "$ext" ]; then
        if [ "$sel" != "$ext" ]; then
            prev="$sel"
            sel="$ext"
            failed=""
        fi
        trial=ok
    elif [ -n "$newslot" ] && [ "$sel" != "$newslot" ]; then
        prev="$sel"
        sel="$newslot"
        trial=pending
        failed=""
        log "$newslot: selected (trial boot)"
    fi
    vendor=""
    if [ -z "$ext" ] && [ -n "$visver" ] && [ "$visver" != "$STOCK" ]; then
        # a driver flashed into /vendor: it is the default entry; selected once when it first shows up
        vendor="$visver"
        if [ "$(gp ${P}vendor_seen)" != "$visver" ]; then
            spc ${P}vendor_seen "$visver"
            if [ "$sel" != "$DEF" ]; then
                prev="$sel"
                sel=$DEF
                trial=ok
            fi
            log "/vendor has $visver instead of $STOCK"
        fi
    elif [ -z "$ext" ]; then
        spc ${P}vendor_seen ""
    fi
    case "$sel" in
        m_* | u_*)
            if [ "$sel" != "$ext" ] && ! valid_choice "$sel"; then
                if has_word "$modslots" "$sel" || [ -d "$STORE/$sel" ] || [ "${sel#u_}" != "$sel" ]; then
                    missing="$sel"
                    log "$sel: missing or damaged, back to V@0$DEF"
                    sel=$DEF
                else
                    # its module went away: back to what was selected before it
                    if [ "$prev" != "$sel" ] && valid_choice "$prev"; then sel="$prev"; else sel=$DEF; fi
                    log "selected module driver gone, back to $sel"
                fi
                trial=ok
                failed=""
            fi
            ;;
        *)
            # an unknown built-in value falls back to the default, but only when the list is readable: an empty or
            # unreadable ro.k4.gpu_drivers must not destroy a valid built-in choice
            if [ -n "$have_list" ]; then
                is_builtin "$sel" || { sel=$DEF; trial=ok; }
            fi
            ;;
    esac

    # safe mode: run the stock driver this boot without changing the stored selection
    safemode=""
    [ "$(gp persist.sys.safemode)" = 1 ] && safemode=1

    # mount the selected user driver (the built-in sets are mounted by the rc at early-boot)
    active=""
    if [ -n "$safemode" ]; then
        log "safe mode: the stock driver is used this boot"
    elif [ -n "$ext" ]; then
        active="$ext"
    else
        case "$sel" in
            m_* | u_*)
                if [ "$trial" = pending ] || [ "$trial" = ok ] || [ -z "$trial" ]; then
                    if mount_set "$sel"; then
                        active="$sel"
                        log "$sel: mounted ($(info_get "$STORE/$sel/info" version))"
                    else
                        undo_mounts
                        missing="$sel"
                        log "$sel: mount failed, back to V@0$DEF"
                        sel=$DEF
                        trial=ok
                        failed=""
                    fi
                fi
                ;;
        esac
    fi

    # the list Settings shows
    {
        for s in $SLOTS; do
            if [ "$s" = "$ext" ]; then
                printf '%s\tmodule\texternal\t%s (module %s)\t%s\n' "$s" "$visver" "$(clean_name "$extid")" "$(clean_name "$extid")"
            else
                i="$STORE/$s/info"
                case "$s" in
                    m_*) printf '%s\tmodule\t-\t%s (module %s)\t%s\n' "$s" "$(info_get "$i" version)" "$(info_get "$i" name)" "$(info_get "$i" name)" ;;
                    u_*) printf '%s\tadded\t-\t%s (added: %s)\t\n' "$s" "$(info_get "$i" version)" "$(info_get "$i" name)" ;;
                esac
            fi
        done
    } > "$LIST.new" && chmod 644 "$LIST.new" && mv "$LIST.new" "$LIST"

    # "previous choice" is only kept while it differs from the current one (it is where a vanished module falls
    # back to); equal to the selection it carries nothing, so it is cleared
    [ "$prev" = "$sel" ] && prev=""
    spc ${P}driver "$sel"
    spc ${P}trial "$trial"
    spc ${P}failed "$failed"
    spc ${P}prev "$prev"
    sp ${S}external "$ext"
    sp ${S}root "$root"
    sp ${S}vendor "$vendor"
    sp ${S}missing "$missing"
    sp ${S}rejected "$(printf '%s' "$rejected" | cut -c 1-91)"
    sp ${S}user_active "$active"
    sp ${S}scan 1
    log "done: selected $sel, trial $trial, user driver mounted: ${active:-none}"
}

# space_ok <source set>: enough free storage for a copy (the set size plus a 64 MB margin), and the store stays under
# its cap. Best-effort: if df/du cannot tell (host tests), allow.
space_ok() {
    _need=0
    for _f in $(files_of "$1"); do
        _fsz="$(stat -c %s "$1/$_f" 2> /dev/null)"
        case "$_fsz" in "" | *[!0-9]*) ;; *) _need=$((_need + _fsz / 1024)) ;; esac
    done
    _used="$(store_kb)"
    case "$_used" in *[0-9]*) [ "$((_used + _need))" -le "$STORE_CAP_KB" ] || { log "store full (${_used} KB)"; return 1; } ;; esac
    _avail="$(free_kb)"
    case "$_avail" in *[0-9]*) [ "$_avail" -ge "$((_need + 65536))" ] || { log "low on storage (${_avail} KB free)"; return 1; } ;; esac
    return 0
}

# guard: KernelSU, before any metamodule mounts modules (see the header): every driver module gets a skip_mount file
# (KernelSU's / Magisk's standard "do not mount this module"; meta-overlayfs, Mountify and the other metamodules honour
# it), so only this selector puts its files in place - imported with the stock labels, the allowlist and a trial boot.
# The file says it is ours (first line starts with GUARD_MARK); a module's own skip_mount is never touched, ours is
# removed again from a module that no longer carries a driver set. Disabled modules are marked too (enabled again,
# they are covered from the start). Nothing with Magisk (it mounts modules itself; a mounted driver is reported).
GUARD_MARK="k4-gpu-driver:"
GUARD_LOG="$ADB/.k4_gpu_guard.log"
glog() {
    echo "k4-gpu-driver: guard: $*" 2> /dev/null > "${K4GPU_KMSG:-/dev/kmsg}"
    echo "$*" >> "$GUARD_LOG" 2> /dev/null
}
guard() {
    [ -d "$ADB/magisk" ] && return 0
    [ -d "$ADB/modules" ] || [ -d "$ADB/modules_update" ] || return 0
    # a short log of the last runs (it runs twice per boot: init.rc and ksud's post-fs-data.d)
    [ "$(stat -c %s "$GUARD_LOG" 2> /dev/null || echo 0)" -gt 65536 ] && : > "$GUARD_LOG"
    marked=""
    for m in "$ADB"/modules/* "$ADB"/modules_update/*; do
        [ -d "$m" ] && [ ! -L "$m" ] || continue
        id="${m##*/}"
        name_ok "$id" || continue
        f="$m/skip_mount"
        first=""
        [ -f "$f" ] && [ ! -L "$f" ] && read -r first < "$f" 2> /dev/null
        if module_driver "$m"; then
            case "$first" in "$GUARD_MARK"*) marked="$marked $id"; continue ;; esac
            if [ -e "$f" ] || [ -L "$f" ]; then
                glog "$id (${m%/*}): Adreno GPU driver module with its own skip_mount, left as it is"
                continue
            fi
            if [ -n "$is32" ]; then why="only 32-bit libraries"; else why="$(check_set "$src")"; fi
            if { echo "$GUARD_MARK Adreno GPU driver module: no metamodule mounts it, the ROM's GPU driver selector imports it (Settings > K4_UN1CA > UI > GPU driver). Set again on every boot." > "$f"; } 2> /dev/null; then
                chmod 0644 "$f" 2> /dev/null  # ksud runs post-fs-data.d scripts with umask 0
                marked="$marked $id"
                glog "$id (${m%/*}): Adreno GPU driver module, skip_mount set (selector check: $why)"
            else
                glog "$id (${m%/*}): Adreno GPU driver module, could not set skip_mount"
            fi
        else
            case "$first" in
                "$GUARD_MARK"*) rm -f "$f" && glog "$id (${m%/*}): no driver set any more, its skip_mount removed" ;;
            esac
        fi
    done
    sp ${S}guard "${marked# }"
}

# settle <seconds>: run from the rc on boot_completed when trial=testing. Promote the trial to "ok" only after the
# device has run <seconds> past boot_completed with no system_server restart. If the device reboots or system_server
# crashes inside the window, the trial stays "testing" and the next boot reverts to the stock driver (failsafe).
settle() {
    [ "$(gp ${P}trial)" = testing ] || return 0
    # the stock driver is never on trial (boot normally turns that into ok first; this covers a boot where it did not)
    if [ "$(gp ${P}driver)" = "$DEF" ]; then
        spc ${P}trial ok
        sp ${S}settle "ok: stock driver, no trial"
        log "settle: the stock driver needs no trial, trial ok"
        return 0
    fi
    window="${1:-150}"
    sp ${S}settle "running: ${window}s window for $(gp ${P}driver)"
    log "settle: ${window}s window for $(gp ${P}driver)"
    step="${K4GPU_SLEEP:-10}"
    base_count="$(gp sys.system_server.start_count)"
    waited=0
    while [ "$waited" -lt "$window" ]; do
        sleep "$step"
        waited=$((waited + 10))
        [ "$(gp sys.boot_completed)" = 1 ] || { sp ${S}settle "stopped: boot_completed cleared, trial stays testing"; return 0; }
        c="$(gp sys.system_server.start_count)"
        [ -z "$base_count" ] || [ -z "$c" ] || [ "$c" = "$base_count" ] || {
            sp ${S}settle "failed: system_server restarted ($base_count -> $c), trial stays testing"
            log "settle: system_server restarted ($base_count -> $c), trial stays testing"
            return 0
        }
    done
    [ "$(gp ${P}trial)" = testing ] || { sp ${S}settle "skipped: trial changed during the window"; return 0; }
    spc ${P}trial ok
    sp ${S}settle "ok: ${window}s stable"
    log "settle: ${window}s stable, trial ok"
}

case "$1" in
    boot) boot ;;
    settle) settle "$2" ;;
    guard) guard ;;
    *) echo "usage: k4-gpu-driver boot|settle [<arg>]|guard" >&2; exit 2 ;;
esac
exit 0
