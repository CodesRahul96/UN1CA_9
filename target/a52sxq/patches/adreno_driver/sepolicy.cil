(allow k4gpu adb_data_file (file (read getattr open)))
(allow k4gpu adb_data_file (lnk_file (read getattr)))
(allow k4gpu k4_gpu_data_file (dir (create read write open getattr setattr search add_name remove_name rmdir rename reparent relabelfrom)))
