(allow init k4gpu (process (transition rlimitinh siginh)))
(dontaudit init k4gpu (process (noatsecure)))
(allow init k4_gpu_data_file (dir (create search getattr setattr read open write add_name relabelto)))
(allow init k4_gpu_incoming_file (dir (create search getattr setattr read open write add_name relabelto)))
