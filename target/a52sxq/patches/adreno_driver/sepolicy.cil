(allow k4gpu vendor_firmware_file (file (read open getattr setattr unlink rename relabelto mounton)))
(allow k4gpu vendor_file (dir (read open getattr search)))
(allow k4gpu vendor_file (file (read open getattr mounton)))
(allow k4gpu vendor_file (lnk_file (read getattr)))
(allow k4gpu vendor_hal_file (dir (getattr search)))
(allow k4gpu vendor_configs_file (dir (getattr search)))
(allow k4gpu vendor_configs_file (file (read open getattr mounton)))
