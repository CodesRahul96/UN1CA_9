(allow k4gpu k4_gpu_incoming_file (dir (read write open getattr search remove_name rmdir)))
(allow k4gpu k4_gpu_incoming_file (file (read open getattr unlink)))
(allow k4gpu k4_gpu_incoming_file (lnk_file (getattr unlink)))
