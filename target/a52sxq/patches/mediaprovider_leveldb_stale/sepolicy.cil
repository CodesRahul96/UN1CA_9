(type k4leveldb)
(roletype r k4leveldb)
(allow init k4leveldb (process (transition rlimitinh siginh)))
(dontaudit init k4leveldb (process (noatsecure)))
(allow k4leveldb shell_exec (file (read getattr map execute open entrypoint)))
(allow k4leveldb toolbox_exec (file (read getattr map execute open execute_no_trans)))
(allow k4leveldb system_file (file (read getattr map open)))
(allow k4leveldb self (capability (dac_override)))
(allow k4leveldb kmsg_device (chr_file (getattr write open)))
(allow k4leveldb system_data_root_file (dir (getattr search)))
(allow k4leveldb system_data_file (dir (getattr search)))
(allow k4leveldb packages_list_file (file (read getattr open)))
(allow k4leveldb media_userdir_file (dir (getattr search read open)))
(allow k4leveldb media_rw_data_file (dir (getattr search read open write remove_name rmdir)))
(allow k4leveldb media_rw_data_file (file (getattr unlink)))
(allow k4leveldb media_rw_data_file (lnk_file (getattr)))
