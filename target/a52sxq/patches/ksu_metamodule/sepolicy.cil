(type k4metamod)
(roletype r k4metamod)
(type k4_metamod_prop)
(roletype object_r k4_metamod_prop)
(type k4_metamod_status_prop)
(roletype object_r k4_metamod_status_prop)
(allow init k4metamod (process (transition rlimitinh siginh)))
(dontaudit init k4metamod (process (noatsecure)))
(allow k4metamod shell_exec (file (read getattr map execute open entrypoint)))
(allow k4metamod toolbox_exec (file (read getattr map execute open execute_no_trans)))
(allow k4metamod system_file (file (read getattr map open)))
(allow k4metamod system_file (dir (read getattr open search)))
(allow k4metamod system_file (lnk_file (read getattr)))
(allow k4metamod kmsg_device (chr_file (getattr write open)))
(allow k4metamod system_data_root_file (dir (getattr search)))
(allow k4metamod adb_data_file (dir (getattr search)))
(allow k4metamod property_socket (sock_file (write)))
(allow k4metamod init (unix_stream_socket (connectto)))
(allow k4metamod k4_metamod_prop (file (read getattr map open)))
(allow k4metamod k4_metamod_status_prop (property_service (set)))
(allow k4metamod k4_metamod_status_prop (file (read getattr map open)))
(allow shell k4_metamod_prop (property_service (set)))
(allow shell k4_metamod_prop (file (read getattr map open)))
(allow shell k4_metamod_status_prop (file (read getattr map open)))
