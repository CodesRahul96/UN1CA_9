#!/system/bin/sh
# KernelSU metamodule by default (target/a52sxq/patches/ksu_metamodule, see module.prop).
#
# Metamodule-era KernelSU (ksud 4.x) mounts no module files itself: without a metamodule (/data/adb/metamodule)
# modules install but their system/ vendor/ files never appear. The ROM ships the official reference metamodule
# (meta-overlayfs, /system/etc/k4/ksu/meta-overlayfs.zip) and installs it through ksud's own installer once, when
# nothing else provides mounting.
#
#   k4-ksu-metamodule gate    (init, sys.boot_completed=1, own domain k4ksumeta: no root powers)
#       Only decides whether KernelSU is active: /data/adb/ksud carries the label ksu_file, a type that exists only
#       while the KernelSU kernel's policy is loaded (it lets every domain use it). Without KernelSU (stock kernel,
#       Magisk) the label is unknown, the stat is denied, and nothing else ever runs. Sets sys.k4.ksu_meta_gate.
#   k4-ksu-metamodule apply   (init, sys.k4.ksu_meta_gate=ksu, KernelSU's own domain u:r:ksu:s0, like ksud's own
#       boot-completed stage). Re-checks everything and installs the metamodule with `ksud module install` when
#           - KernelSU is present (/data/adb/ksud) and Magisk is not (ksud itself skips everything with Magisk),
#           - this is not a safe-mode boot,
#           - no metamodule is installed or pending (the /data/adb/metamodule link, or any module in modules/ or
#             modules_update/ with metamodule=1|true - also a disabled one or one marked for removal),
#           - the user has not opted out: persist.sys.k4.ksu_metamodule=0 (any time), or the opt-out marker
#             /data/adb/.k4_metamodule_optout, written here when a metamodule that was seen on an earlier boot
#             (ours or the user's own: /data/adb/.k4_metamodule_seen) is gone. Uninstalling the metamodule in the
#             KernelSU manager is therefore the opt-out, and switching metamodules (uninstall, reboot, install the
#             other one) is never raced: the boot in between finds the last one gone and stands down for good.
#             persist.sys.k4.ksu_metamodule=1 re-arms it once (clears the markers, then goes back to automatic).
#       ksud installs into /data/adb/modules_update and links /data/adb/metamodule at once; this hook then completes
#       the install itself, the way ksud's next post-fs-data would (handle_updated_modules: the staged directory
#       replaces /data/adb/modules/<id>, which holds only module.prop and the "update" marker): while a metamodule
#       with a metainstall.sh is pending ("update" marker), ksud refuses EVERY module install ("Installation
#       Blocked ... Current state: Pending changes ... Reboot to apply changes first") - what testers hit installing
#       TEE Simulator on the first boot of 9.3.83. So modules install at once; their files are mounted from the next
#       boot on (ksud's mount step runs at post-fs-data; ksud refuses to install anything before boot_completed).
#       It never touches another metamodule or any other module; a failed install is cleaned up (only what this
#       run created) and retried on the next boot, at most 3 times.
#       Update: the shipped zip is the ROM's build 1.3.1-k4.1 (versionCode 13101; Adreno GPU driver modules are
#       left to the GPU driver selector, label fixes, see meta-overlayfs-k4/K4_CHANGES.txt). An installed
#       meta-overlayfs with a lower versionCode (the unmodified 1.3.1 = 13100, which an earlier build installed and
#       which bootlooped the phone with a GPU driver module) is updated IN PLACE: the zip's files replace the
#       installed ones one by one (atomic renames; the arch binary as meta-overlayfs, like its customize.sh does),
#       its modules image and mount point stay as they are. Not through `ksud module install`: that stages a copy
#       and leaves the metamodule pending (see above) until a reboot, and its staged directory could not be swapped
#       in now - the installed one's image is loop-mounted under it and is the live overlay's lower layer.
#       Not done when it is disabled, marked for removal or already has an update pending. A newer one (a later
#       upstream release the user installed) is left alone.
#       Result: sys.k4.ksu_meta, log /data/adb/.k4_metamodule.log and the kernel log.
#       Modules installed before the metamodule (import): meta-overlayfs mounts only what its metainstall.sh copied
#       into its modules.img when a module was installed through it, so a module installed earlier (no metamodule
#       yet, or another metamodule such as Mountify) stayed unmounted until it was reinstalled. While meta-overlayfs
#       is the metamodule (and not disabled, marked for removal or pending), every module in /data/adb/modules that
#       metainstall.sh would have copied - a system/ directory; not disabled, marked for removal, skip_mount or
#       pending an update; not a metamodule; not an Adreno GPU driver module (the GPU driver selector imports those)
#       - and that has no copy in the image yet is copied into it the way metainstall.sh does it: system/ vendor/
#       product/ system_ext/ odm/ oem/ with cp -af and ksud's busybox, every file and directory given the module's
#       label (copy_selinux_contexts), directories that exist on the partition the partition's label (K4 change 3,
#       k4_dir_labels; both functions are metainstall.sh's own, test/run.sh checks they stay identical), and like
#       KernelSU's installer a system/<partition> that is a real directory while /<partition> is a native one
#       (layout left by Mountify / Magic Mount; Mountify's <partition> -> ./system/<partition> link is dropped) is
#       moved out to <partition>/ in the copy (system/<partition> -> a ../<partition> link). Copied to mnt/.k4import.<id> first and renamed to mnt/<id> when complete, so a
#       partial copy is never mounted. A module already in the image is never touched; a module whose copy failed
#       is not tried again until it is reinstalled (.k4_metamodule_import_failed). The image is the live overlay's
#       lower layer, but a new mnt/<id> directory is not part of any mounted layer (metainstall.sh adds modules the
#       same way at runtime). Mounted from the next boot on. Result: sys.k4.ksu_meta_import.
#
# Host tests: K4KSU_ROOT (path prefix), K4KSU_PROPFILE (properties in a file), K4KSU_KSUD (ksud to run),
# K4KSU_ZIP / K4KSU_ZIP_SHA256 (the zip and its pin), K4KSU_KMSG (kernel log file), K4KSU_NOMAGISK (skip the
# magisk-in-PATH check), K4KSU_BUSYBOX (busybox for the import, empty: the current shell's tools), K4KSU_FAKEIMG
# (the image is a plain directory: mnt/ counts as mounted).

R="${K4KSU_ROOT:-}"
ADB="$R/data/adb"
ID=meta-overlayfs
ZIP="${K4KSU_ZIP:-/system/etc/k4/ksu/meta-overlayfs.zip}"
# meta-overlayfs 1.3.1-k4.1 (versionCode 13101): the official v1.3.1 release with the K4 changes
# (meta-overlayfs-k4/, built by meta-overlayfs-k4/make_zip.sh; checked by the build as well)
ZIP_SHA256="${K4KSU_ZIP_SHA256:-73695f19fd362620738955069306963ef9dde119ce509c3ce90aa27a76ff0669}"
ZIP_VC=13101
KSUD="${K4KSU_KSUD:-$ADB/ksud}"
OPT="$ADB/.k4_metamodule_optout"
SEEN="$ADB/.k4_metamodule_seen"
TRIES="$ADB/.k4_metamodule_tries"
LOGF="$ADB/.k4_metamodule.log"
IMPORT_FAILED="$ADB/.k4_metamodule_import_failed"
# ksud's busybox: metainstall.sh runs under it (ksud executes install scripts with `busybox sh`, applets first), so
# the import does too - same cp, chcon (--reference), find, mount
BB="${K4KSU_BUSYBOX-$ADB/ksu/bin/busybox}"
MAX_TRIES=3
P=persist.sys.k4.ksu_metamodule

log() {
    echo "k4-ksu-metamodule: $*" 2> /dev/null > "${K4KSU_KMSG:-/dev/kmsg}"
    case "$MODE" in apply | import) echo "$*" >> "$LOGF" 2> /dev/null ;; esac
}

gp() {
    if [ -n "$K4KSU_PROPFILE" ]; then
        awk -v k="$1" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { print v }' "$K4KSU_PROPFILE"
    else
        getprop "$1"
    fi
}

sp() {
    if [ -n "$K4KSU_PROPFILE" ]; then
        echo "$1=$2" >> "$K4KSU_PROPFILE"
    else
        setprop "$1" "$2"
    fi
}

status() {
    sp sys.k4.ksu_meta "$1"
    log "${2:-$1}"
}

# a module.prop that marks a metamodule (ksud: metamodule=1 or true, case-insensitive, trimmed)
is_meta_prop() {
    [ -f "$1" ] || return 1
    v="$(sed -n 's/^metamodule=//p' "$1" 2> /dev/null | head -n 1 | tr -d ' \t\r' | tr 'A-Z' 'a-z')"
    [ "$v" = 1 ] || [ "$v" = true ]
}

# prints the id of the installed (or pending) metamodule, empty if there is none. Same lookup as ksud
# (get_metamodule_path): the /data/adb/metamodule link if it leads to a directory, else any module with
# metamodule=1; here modules_update/ counts too (a metamodule installed on this boot, not moved yet).
find_meta() {
    if [ -L "$ADB/metamodule" ]; then
        t="$(readlink "$ADB/metamodule" 2> /dev/null)"
        t="${t%/}"
        case "$t" in
            /*) [ -d "$t" ] || t="$R$t" ;;
            *) t="$ADB/$t" ;;
        esac
        if [ -n "${t##*/}" ] && [ -d "$t" ]; then
            echo "${t##*/}"
            return
        fi
    elif [ -d "$ADB/metamodule" ]; then
        # not a link (made by hand / an old tool): ksud would replace it, but it is somebody's metamodule
        echo metamodule
        return
    fi
    for m in "$ADB"/modules/* "$ADB"/modules_update/*; do
        [ -d "$m" ] || continue
        is_meta_prop "$m/module.prop" && { echo "${m##*/}"; return; }
    done
}

gate() {
    if [ "$(gp $P)" = 0 ]; then
        sp sys.k4.ksu_meta_gate off
        return
    fi
    # stat of a ksu_file: only possible while the KernelSU policy is loaded (see the header)
    if [ -e "$ADB/ksud" ]; then
        sp sys.k4.ksu_meta_gate ksu
    else
        sp sys.k4.ksu_meta_gate none
    fi
}

# versionCode of a module.prop (digits only, empty if none)
vc_of() {
    sed -n 's/^versionCode=//p' "$1" 2> /dev/null | head -n 1 | tr -dc 0-9
}

zip_ok() {
    [ -f "$ZIP" ] && [ "$(sha256sum "$ZIP" 2> /dev/null | cut -d ' ' -f 1)" = "$ZIP_SHA256" ]
}

# the installed meta-overlayfs is older than the shipped build: update it (see the header). Returns 1 when there
# is nothing to update (the caller reports "active"), 0 when it handled the status itself.
update() {
    m="$ADB/modules/$ID"
    vc="$(vc_of "$m/module.prop")"
    [ -n "$vc" ] && [ "$vc" -lt "$ZIP_VC" ] || return 1
    if [ -e "$m/disable" ] || [ -e "$m/remove" ] || [ -e "$ADB/modules_update/$ID" ]; then
        log "$ID $vc is disabled, marked for removal or has an update pending: not updated"
        return 1
    fi
    tries="$(cat "$TRIES" 2> /dev/null)"
    case "$tries" in "" | *[!0-9]*) tries=0 ;; esac
    if [ "$tries" -ge "$MAX_TRIES" ]; then
        status active "metamodule $ID $vc installed; its update failed $tries times, not tried again"
        return 0
    fi
    if ! zip_ok; then
        status active "metamodule $ID $vc installed; $ZIP missing or not the pinned build, not updated"
        return 0
    fi
    echo $((tries + 1)) > "$TRIES"
    log "updating $ID $vc to $ZIP_VC in place (try $((tries + 1)))"
    if update_in_place "$m"; then
        rm -f "$TRIES"
        status updated "$ID updated from $vc to $ZIP_VC in place: nothing pending, module installs work right away"
    else
        status active "metamodule $ID $vc installed; in-place update to $ZIP_VC failed, retried next boot"
    fi
    return 0
}

# the binary the zip's customize.sh installs as meta-overlayfs on this device
arch_binary() {
    case "$(gp ro.product.cpu.abi)" in
        x86_64) echo meta-overlayfs-x86_64 ;;
        *) echo meta-overlayfs-aarch64 ;;
    esac
}

# update_in_place <module dir>: every file of the zip (but customize.sh, which only picks the binary and makes the
# image, and the binaries, of which the device's one becomes meta-overlayfs) replaces the installed one: written next
# to it, given its mode and label (a new file: mode from the zip, label of module.prop), renamed over it. Files the
# zip does not have (modules.img, mnt/) are not touched. Checked afterwards.
update_in_place() {
    t="$ADB/.k4_metamodule.tmp"
    rm -rf "$t"
    mkdir -p "$t" && (cd "$t" && unzip -q -o "$ZIP") > /dev/null 2>&1 || { rm -rf "$t"; return 1; }
    b="$(arch_binary)"
    [ -f "$t/$b" ] || { rm -rf "$t"; return 1; }
    pairs=""
    for f in $(cd "$t" && find . -type f | sed 's|^\./||' | LC_ALL=C sort); do
        case "$f" in
            customize.sh | meta-overlayfs-aarch64 | meta-overlayfs-x86_64 | module.prop) continue ;;
            */* | *[!A-Za-z0-9._-]*) continue ;;  # the release has no subdirectories or odd names
        esac
        pairs="$pairs $f:$f"
    done
    # module.prop (the versionCode) last: an interrupted update is retried on the next boot
    pairs="$pairs $b:meta-overlayfs module.prop:module.prop"
    for p in $pairs; do
        src="$t/${p%%:*}"
        dst="$1/${p#*:}"
        cmp -s "$src" "$dst" && continue
        cp "$src" "$dst.k4new" || { rm -rf "$t" "$dst.k4new"; return 1; }
        if [ -f "$dst" ]; then
            chmod "$(stat -c %a "$dst")" "$dst.k4new"
            chcon --reference="$dst" "$dst.k4new" 2> /dev/null
        else
            chmod "$(stat -c %a "$src")" "$dst.k4new"
            chcon --reference="$1/module.prop" "$dst.k4new" 2> /dev/null
        fi
        [ "${p#*:}" = meta-overlayfs ] && chmod 755 "$dst.k4new"
        mv -f "$dst.k4new" "$dst" || { rm -rf "$t" "$dst.k4new"; return 1; }
    done
    for p in $pairs; do
        cmp -s "$t/${p%%:*}" "$1/${p#*:}" || { rm -rf "$t"; return 1; }
    done
    rm -rf "$t"
    return 0
}

# complete a fresh `ksud module install` of $ID now instead of on the next boot (see the header): the staged
# directory replaces /data/adb/modules/$ID (module.prop + "update" only), like ksud's handle_updated_modules. Only
# when nothing is mounted under that directory (never true for a fresh install, checked anyway).
complete_install() {
    u="$ADB/modules_update/$ID"
    m="$ADB/modules/$ID"
    [ -d "$u" ] || return 1
    [ -n "$(awk -v d="$m/" 'index($2 "/", d) == 1' /proc/mounts 2> /dev/null)" ] && return 1
    if [ -d "$m" ]; then
        for f in "$m"/* "$m"/.[!.]*; do
            [ -e "$f" ] || continue
            case "${f##*/}" in module.prop | update) ;; *) return 1 ;; esac
        done
        rm -rf "$m" || return 1
    fi
    mv "$u" "$m"
}

# undo what a failed `ksud module install` of $ID left behind (only called when none of it existed before)
cleanup_failed() {
    rm -rf "${ADB:?}/modules_update/$ID" "${ADB:?}/modules/$ID"
    if [ -L "$ADB/metamodule" ]; then
        t="$(readlink "$ADB/metamodule")"
        [ "${t%/}" = "/data/adb/modules/$ID" ] || [ "${t%/}" = "$ADB/modules/$ID" ] && rm -f "$ADB/metamodule"
    fi
}

# --- modules installed before the metamodule (see the header: "import") ---------------------------------------------

# meta-overlayfs-k4/metainstall.sh's own function, unchanged (test/run.sh checks that the two are identical)
# Copy SELinux contexts from src tree to destination by mirroring each entry.
copy_selinux_contexts() {
    command -v chcon >/dev/null 2>&1 || return 0

    SRC="$1"
    DST="$2"

    if [ -z "$SRC" ] || [ -z "$DST" ] || [ ! -e "$SRC" ] || [ ! -e "$DST" ]; then
        return 0
    fi

    CHCON_FLAG=""
    if [ -L "$SRC" ]; then
        CHCON_FLAG="-h"
    fi
    chcon $CHCON_FLAG --reference="$SRC" "$DST" 2>/dev/null || true

    find "$SRC" -print | while IFS= read -r PATH_SRC; do
        if [ "$PATH_SRC" = "$SRC" ]; then
            continue
        fi
        REL_PATH="${PATH_SRC#"${SRC}/"}"
        PATH_DST="$DST/$REL_PATH"
        if [ -e "$PATH_DST" ] || [ -L "$PATH_DST" ]; then
            CHCON_FLAG=""
            if [ -L "$PATH_SRC" ]; then
                CHCON_FLAG="-h"
            fi
            chcon $CHCON_FLAG --reference="$PATH_SRC" "$PATH_DST" 2>/dev/null || true
        fi
    done
}

# meta-overlayfs-k4/metainstall.sh's own function, unchanged (test/run.sh checks that the two are identical)
# K4: directories that exist on the partition take its label (change 3); $1 = image copy, $2 = partition root
k4_dir_labels() {
    command -v chcon >/dev/null 2>&1 || return 0
    [ -d "$1" ] && [ ! -L "$1" ] || return 0
    find "$1" -type d | while IFS= read -r K4_D; do
        K4_R="${K4_D#"$1"}"
        K4_P="$2$K4_R"
        if [ -d "$K4_P" ] && [ ! -L "$K4_P" ]; then
            chcon --reference="$K4_P" "$K4_D" 2>/dev/null || true
        fi
    done
}

# a module carrying an Adreno GPU driver set (the GPU driver selector's own detection, as in metainstall.sh): never
# copied into the image, whether or not the selector exists - mounted from there it bootlooped the phone
gpu_driver_module() {
    for v in "$1/vendor" "$1/system/vendor"; do
        for l in lib64 lib; do
            [ -f "$v/$l/egl/libGLESv2_adreno.so" ] && return 0
        done
    done
    return 1
}

img_mounted() {
    if [ -n "$K4KSU_FAKEIMG" ]; then
        [ -d "$1" ]
    else
        mountpoint -q "$1" 2> /dev/null
    fi
}

# the ids of the modules metainstall.sh would have copied into the image (see the header), image or not
import_candidates() {
    for d in "$ADB"/modules/*; do
        [ -d "$d" ] && [ ! -L "$d" ] || continue
        id="${d##*/}"
        # a KernelSU module id ([a-zA-Z][a-zA-Z0-9._-]+, ksud's validate_module_id); anything else is hand-made
        case "$id" in [A-Za-z]?*) ;; *) continue ;; esac
        case "$id" in *[!A-Za-z0-9._-]*) continue ;; esac
        [ "$id" = "$ID" ] && continue
        [ -f "$d/module.prop" ] || continue
        is_meta_prop "$d/module.prop" && continue
        [ -e "$d/disable" ] || [ -e "$d/remove" ] || [ -e "$d/skip_mount" ] || [ -e "$d/update" ] && continue
        [ -e "$ADB/modules_update/$id" ] && continue
        [ -d "$d/system" ] || continue
        gpu_driver_module "$d" && continue
        echo "$id"
    done
}

# import_one <id> <image mount point>: the module's partition directories into <mnt>/<id>, like metainstall.sh's
# post_install_to_image (all or nothing: copied next to it, renamed when complete)
import_one() {
    d="$ADB/modules/$1"
    t="$2/.k4import.$1"
    rm -rf "$t"
    mkdir "$t" || return 1
    chown 0:0 "$t" 2> /dev/null
    chmod 0755 "$t"
    chcon u:object_r:system_file:s0 "$t" 2> /dev/null
    for p in system vendor product system_ext odm oem; do
        [ -d "$d/$p" ] || continue
        cp -af "$d/$p" "$t/" || { rm -rf "$t"; return 1; }
        copy_selinux_contexts "$d/$p" "$t/$p"
    done
    # KernelSU's installer (handle_partition) moves system/<partition> out when /<partition> is a native directory;
    # a module installed under Mountify / Magic Mount still has it inside system/ (Mountify adds a <partition> ->
    # ./system/<partition> link next to it, replaced here by the directory itself)
    for p in vendor system_ext product odm; do
        [ -d "$t/system/$p" ] && [ ! -L "$t/system/$p" ] && [ -d "$R/$p" ] && [ ! -L "$R/$p" ] || continue
        [ -L "$t/$p" ] && rm -f "$t/$p"
        if [ -e "$t/$p" ] || [ -L "$t/$p" ]; then
            log "import: $1 has both $p/ and system/$p/, not imported"
            rm -rf "$t"
            return 1
        fi
        mv "$t/system/$p" "$t/$p" && ln -s "../$p" "$t/system/$p" || { rm -rf "$t"; return 1; }
        chcon -h u:object_r:system_file:s0 "$t/system/$p" 2> /dev/null
    done
    for p in system vendor product system_ext odm oem; do
        k4_dir_labels "$t/$p" "$R/$p"
    done
    mv "$t" "$2/$1"
}

# runs under ksud's busybox (import_modules starts it): every candidate without a copy in the image is copied
do_import() {
    m="$ADB/modules/$ID"
    img="$m/modules.img"
    mnt="$m/mnt"
    [ -f "$img" ] || { log "import: no $ID modules image"; return 0; }
    ids="$(import_candidates)"
    [ -n "$ids" ] || { sp sys.k4.ksu_meta_import none; return 0; }
    if ! img_mounted "$mnt"; then
        # as metainstall.sh's ensure_image_mounted
        mkdir -p "$mnt"
        chcon u:object_r:ksu_file:s0 "$img" 2> /dev/null
        if ! mount -t ext4 -o loop,rw,noatime "$img" "$mnt"; then
            log "import: could not mount $img"
            sp sys.k4.ksu_meta_import "failed: image not mounted"
            return 0
        fi
    fi
    rm -rf "$mnt"/.k4import.* 2> /dev/null
    done_ids=""
    failed_ids=""
    for id in $ids; do
        [ -e "$mnt/$id" ] || [ -L "$mnt/$id" ] && continue
        sig="$id $(stat -c %i "$ADB/modules/$id" 2> /dev/null)"
        if grep -q -x -F "$sig" "$IMPORT_FAILED" 2> /dev/null; then
            failed_ids="$failed_ids $id"
            continue
        fi
        # metainstall.sh's set_perm "$MNT_DIR" 0 0 0755
        chown 0:0 "$mnt" 2> /dev/null
        chmod 0755 "$mnt"
        chcon u:object_r:system_file:s0 "$mnt" 2> /dev/null
        if import_one "$id" "$mnt"; then
            done_ids="$done_ids $id"
            log "import: $id (installed before the metamodule) copied into the $ID image, mounted from the next boot on"
        else
            echo "$sig" >> "$IMPORT_FAILED"
            failed_ids="$failed_ids $id"
            log "import: copying $id into the $ID image failed (not tried again until it is reinstalled)"
        fi
    done
    v="${done_ids# }"
    [ -n "$failed_ids" ] && v="${v:+$v; }failed:$failed_ids"
    sp sys.k4.ksu_meta_import "${v:-none}"
}

# the import, under ksud's busybox when there is one (see BB)
import_modules() {
    m="$ADB/modules/$ID"
    if [ -e "$m/disable" ] || [ -e "$m/remove" ] || [ -e "$ADB/modules_update/$ID" ] || [ ! -f "$m/metamount.sh" ]; then
        return 0
    fi
    if [ -n "$BB" ] && [ -x "$BB" ]; then
        ASH_STANDALONE=1 "$BB" sh "$0" import
    else
        do_import
    fi
}

apply() {
    : > "$LOGF" 2> /dev/null
    mode="$(gp $P)"
    if [ "$mode" = 0 ]; then
        status off "turned off (persist.sys.k4.ksu_metamodule=0)"
        return
    fi
    if [ ! -f "$KSUD" ]; then
        status none "no KernelSU (no /data/adb/ksud)"
        return
    fi
    if [ -z "$K4KSU_NOMAGISK" ] && command -v magisk > /dev/null 2>&1; then
        status magisk "Magisk found, it mounts modules itself"
        return
    fi
    if [ "$(gp persist.sys.safemode)" = 1 ] || [ "$(gp ro.sys.safemode)" = 1 ]; then
        status safemode "safe mode boot, nothing done"
        return
    fi
    if [ "$mode" = 1 ]; then
        rm -f "$OPT" "$SEEN" "$TRIES"
        sp $P ""
        log "re-armed (persist.sys.k4.ksu_metamodule=1): opt-out cleared"
    fi

    meta="$(find_meta)"
    if [ -n "$meta" ]; then
        [ "$(cat "$SEEN" 2> /dev/null)" = "$meta" ] || echo "$meta" > "$SEEN"
        if [ "$meta" = "$ID" ]; then
            if ! update; then
                rm -f "$TRIES"
                status active "metamodule $ID installed"
            fi
            import_modules
        else
            rm -f "$TRIES"
            status "other:$meta" "the user's metamodule $meta is installed, nothing done"
        fi
        return
    fi

    if [ -f "$OPT" ]; then
        status optout "opted out ($(head -n 1 "$OPT" 2> /dev/null)), nothing done"
        return
    fi
    if [ -s "$SEEN" ]; then
        was="$(head -n 1 "$SEEN")"
        echo "removed $was" > "$OPT"
        rm -f "$SEEN" "$TRIES"
        status optout "metamodule $was was removed: opted out, it is not installed again"
        return
    fi
    if [ -e "$ADB/modules/$ID" ] || [ -e "$ADB/modules_update/$ID" ]; then
        status conflict "a module $ID exists that is not a metamodule, nothing done"
        return
    fi
    tries="$(cat "$TRIES" 2> /dev/null)"
    case "$tries" in "" | *[!0-9]*) tries=0 ;; esac
    if [ "$tries" -ge "$MAX_TRIES" ]; then
        status failed "install failed $tries times, not tried again (persist.sys.k4.ksu_metamodule=1 retries)"
        return
    fi
    if ! zip_ok; then
        status failed "$ZIP missing or not the pinned build"
        return
    fi

    echo $((tries + 1)) > "$TRIES"
    log "installing $ID (try $((tries + 1))): $KSUD module install $ZIP"
    "$KSUD" module install "$ZIP" >> "$LOGF" 2>&1
    rc=$?
    if [ "$rc" = 0 ] && is_meta_prop "$ADB/modules_update/$ID/module.prop" && [ "$(find_meta)" = "$ID" ]; then
        echo "$ID" > "$SEEN"
        rm -f "$TRIES"
        if complete_install; then
            status installed "$ID installed (completed now, nothing pending): module files are mounted from the next boot on"
            import_modules
        else
            status installed "$ID installed: pending until the next boot (module installs are blocked until then)"
        fi
    else
        cleanup_failed
        status failed "ksud module install failed (exit $rc), cleaned up, retried next boot"
    fi
}

MODE="$1"
case "$1" in
    gate) gate ;;
    apply) apply ;;
    import) do_import ;;  # started by apply (import_modules), under ksud's busybox
    *) echo "usage: k4-ksu-metamodule gate|apply" >&2; exit 2 ;;
esac
exit 0
