(type k4apexdm)
(roletype r k4apexdm)
(allow init k4apexdm (process (transition rlimitinh siginh)))
(dontaudit init k4apexdm (process (noatsecure)))
(allow k4apexdm shell_exec (file (read getattr map execute open entrypoint)))
(allow k4apexdm toolbox_exec (file (read getattr map execute open execute_no_trans)))
(allow k4apexdm system_file (file (read getattr map open)))
(allow k4apexdm apex_mnt_dir (dir (getattr search)))
(allow k4apexdm apex_info_file (file (read getattr open)))
(allow k4apexdm block_device (dir (getattr search)))
(allow k4apexdm dm_device (blk_file (getattr)))
(allow k4apexdm apex_dm_device (blk_file (getattr)))
(allow k4apexdm sysfs (dir (getattr search)))
(allow k4apexdm sysfs_dm (dir (getattr search)))
(allow k4apexdm sysfs_dm (file (getattr write open)))
(allow k4apexdm kmsg_device (chr_file (getattr write open)))
