#!/system/bin/sh
# Play Integrity module stack by default (target/a52sxq/patches/pif_stack, see module.prop).
#
# The framework PlayIntegrityHooks (unica/mods/pif) no longer get DEVICE/STRONG on One UI 9 / Android 17. What
# passes BASIC+DEVICE+STRONG on this phone (2026-10-29) is a KernelSU module stack: Zygisk Next 1.5.2 (864),
# TEESimulator v4.0 canary 73 and Play Integrity Fix v4.9-inject-s (490). The ROM ships those exact zips in
# /system/etc/k4/gmscompat/ (root only) and installs them through ksud's own installer.
#
#   k4-gmscompat apply   (init, KernelSU's own domain u:r:ksu:s0; started when k4_metamod has stopped - that only
#       runs after its gate found KernelSU - and again whenever persist.sys.unica.pif changes, the Settings
#       "Play Integrity Fix" switch). Nothing with Magisk or in safe mode, nothing while a metamodule install is
#       pending (ksud blocks every install until the reboot; tried again on the next boot).
#       persist.sys.unica.pif unset or true (default):
#           - a module of the stack that is missing is installed (zygisksu, teesim, playintegrityfix in that order:
#             PIF's installer aborts without a Zygisk). Before the teesim / PIF install, the configs that passed are
#             seeded where none exist: /data/adb/teesim/{config.json,overrides.json,keybox.xml} (the keybox only when
#             the build shipped one), /data/adb/pif.prop. An existing config or keybox is never touched.
#           - not installed: zygisksu when another Zygisk provides libzygisk.so (ReZygisk, NeoZygisk...), teesim
#             when TrickyStore is installed (same keystore hook; its installer would disable TrickyStore).
#           - a module this hook installed that is now gone was removed by the user: not installed again
#             (/data/adb/.k4_gmscompat/<id>.removed). Turning the switch off and on again re-arms all of them.
#           - a module this hook installed with a lower versionCode than the shipped one is updated (ksud stages it,
#             active from the next boot). Modules the user installed (any version) are left alone.
#           - a module this hook disabled because the switch was off is enabled again.
#       persist.sys.unica.pif=false: every module of the stack that is enabled is disabled (ksud module disable,
#           also the user's own: the switch is the stack's off switch), remembered in <id>.off.
#       Enable/disable/install take effect from the next boot (zygote loads Zygisk modules at start).
#       At most 3 failed installs per module (<id>.tries), then not tried again until the switch is turned off and on.
#       Result: sys.k4.gmscompat, log /data/adb/.k4_gmscompat.log and the kernel log.
#   Legacy: builds before this hook used persist.sys.unica.pif for the framework hooks. On the first run (no state
#       directory yet) a false from those builds is reset to true: the framework hooks are gone and the switch now
#       means this stack.
#
# Host tests: K4GC_ROOT (path prefix), K4GC_PROPFILE (properties in a file), K4GC_KSUD (ksud to run), K4GC_SRC (the
# shipped files), K4GC_KMSG (kernel log file), K4GC_NOMAGISK (skip the magisk-in-PATH check). test/run.sh.

R="${K4GC_ROOT:-}"
ADB="$R/data/adb"
SRC="${K4GC_SRC:-/system/etc/k4/gmscompat}"
KSUD="${K4GC_KSUD:-$ADB/ksud}"
ST="$ADB/.k4_gmscompat"
LOGF="$ADB/.k4_gmscompat.log"
P=persist.sys.unica.pif
MAX_TRIES=3
# install order: playintegrityfix's customize.sh aborts unless some module has a libzygisk.so
IDS="zygisksu teesim playintegrityfix"

log() {
    echo "k4-gmscompat: $*" 2> /dev/null > "${K4GC_KMSG:-/dev/kmsg}"
    echo "$*" >> "$LOGF" 2> /dev/null
}

gp() {
    if [ -n "$K4GC_PROPFILE" ]; then
        awk -v k="$1" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { print v }' "$K4GC_PROPFILE"
    else
        getprop "$1"
    fi
}

sp() {
    if [ -n "$K4GC_PROPFILE" ]; then
        echo "$1=$2" >> "$K4GC_PROPFILE"
    else
        setprop "$1" "$2"
    fi
}

vc_of() {
    sed -n 's/^versionCode=//p' "$1" 2> /dev/null | head -n 1 | tr -dc 0-9
}

# "<sha256> <versionCode>" of a shipped zip, from the manifest written at build time
manifest() {
    awk -v z="$1.zip" '$1 == z { print $2, $3 }' "$SRC/manifest" 2> /dev/null
}

zip_ok() {
    want="$(manifest "$1" | cut -d ' ' -f 1)"
    [ -n "$want" ] && [ "$(sha256sum "$SRC/$1.zip" 2> /dev/null | cut -d ' ' -f 1)" = "$want" ]
}

installed() {
    [ -d "$ADB/modules/$1" ] && [ ! -e "$ADB/modules/$1/remove" ]
}

pending() {
    [ -d "$ADB/modules_update/$1" ]
}

# a metamodule (module.prop metamodule=1|true) staged in modules_update: ksud refuses every install until the reboot
meta_pending() {
    for m in "$ADB"/modules_update/*; do
        [ -f "$m/module.prop" ] || continue
        v="$(sed -n 's/^metamodule=//p' "$m/module.prop" | head -n 1 | tr -d ' \t\r' | tr 'A-Z' 'a-z')"
        [ "$v" = 1 ] || [ "$v" = true ] && return 0
    done
    return 1
}

# another module provides Zygisk (what PIF's own installer checks)
other_zygisk() {
    for f in "$ADB"/modules/*/lib*/libzygisk.so "$ADB"/modules/*/lib/*/libzygisk.so \
        "$ADB"/modules_update/*/lib*/libzygisk.so "$ADB"/modules_update/*/lib/*/libzygisk.so; do
        [ -f "$f" ] || continue
        m="${f#"$ADB"/modules*/}"
        m="${m%%/*}"
        [ "$m" = zygisksu ] && continue
        [ -e "$ADB/modules/$m/disable" ] || [ -e "$ADB/modules/$m/remove" ] || return 0
    done
    return 1
}

seed() {
    # $1 source file in $SRC/seed, $2 destination: only where there is none
    [ -f "$SRC/seed/$1" ] || return 0
    [ -e "$2" ] && return 0
    mkdir -p "${2%/*}" && cp "$SRC/seed/$1" "$2" && chmod "${3:-644}" "$2" && log "seeded $2"
}

install_one() {
    id="$1"
    tries="$(cat "$ST/$id.tries" 2> /dev/null)"
    case "$tries" in "" | *[!0-9]*) tries=0 ;; esac
    if [ "$tries" -ge "$MAX_TRIES" ]; then
        log "$id: install failed $tries times, not tried again (turn the switch off and on to retry)"
        return 1
    fi
    if ! zip_ok "$id"; then
        log "$id: $SRC/$id.zip missing or not the pinned build"
        return 1
    fi
    case "$id" in
        teesim)
            seed teesim_config.json "$ADB/teesim/config.json"
            seed teesim_overrides.json "$ADB/teesim/overrides.json"
            seed keybox.xml "$ADB/teesim/keybox.xml" 600
            ;;
        playintegrityfix) seed pif.prop "$ADB/pif.prop" ;;
    esac
    echo $((tries + 1)) > "$ST/$id.tries"
    log "$id: installing (try $((tries + 1))): $KSUD module install $SRC/$id.zip"
    "$KSUD" module install "$SRC/$id.zip" >> "$LOGF" 2>&1
    rc=$?
    if [ "$rc" = 0 ] && pending "$id"; then
        rm -f "$ST/$id.tries"
        echo "$(manifest "$id" | cut -d ' ' -f 2)" > "$ST/$id.ours"
        log "$id: installed, active from the next boot"
        return 0
    fi
    log "$id: ksud module install failed (exit $rc)"
    return 1
}

apply_on() {
    if [ "$(cat "$ST/switch" 2> /dev/null)" = off ]; then
        # the user turned the switch off and on again: re-arm everything
        rm -f "$ST"/*.removed "$ST"/*.tries
        log "switch turned on again: removed modules and failed installs re-armed"
    fi
    echo on > "$ST/switch"
    res=""
    for id in $IDS; do
        if [ -e "$ST/$id.off" ]; then
            rm -f "$ST/$id.off"
            if installed "$id" && [ -e "$ADB/modules/$id/disable" ]; then
                "$KSUD" module enable "$id" >> "$LOGF" 2>&1 && log "$id: enabled again"
            fi
        fi
        if pending "$id"; then
            res="$res $id:pending"
            continue
        fi
        if installed "$id"; then
            if [ -f "$ST/$id.ours" ]; then
                have="$(vc_of "$ADB/modules/$id/module.prop")"
                want="$(manifest "$id" | cut -d ' ' -f 2)"
                if [ -n "$have" ] && [ -n "$want" ] && [ "$have" -lt "$want" ]; then
                    log "$id: ours at $have, shipped $want: updating"
                    install_one "$id" && { res="$res $id:updated"; continue; }
                    res="$res $id:update-failed"
                    continue
                fi
                res="$res $id:ours"
            else
                res="$res $id:user"
            fi
            continue
        fi
        if [ -e "$ST/$id.removed" ]; then
            res="$res $id:removed"
            continue
        fi
        if [ -f "$ST/$id.ours" ]; then
            rm -f "$ST/$id.ours"
            : > "$ST/$id.removed"
            log "$id: installed by this hook and now gone: removed by the user, not installed again"
            res="$res $id:removed"
            continue
        fi
        if [ "$id" = zygisksu ] && other_zygisk; then
            log "zygisksu: another Zygisk is installed, not installed"
            res="$res $id:other"
            continue
        fi
        if [ "$id" = teesim ] && { installed tricky_store || pending tricky_store; }; then
            log "teesim: TrickyStore is installed, not installed"
            res="$res $id:other"
            continue
        fi
        if install_one "$id"; then
            res="$res $id:installed"
        else
            res="$res $id:failed"
        fi
    done
    sp sys.k4.gmscompat "on${res}"
    log "on:${res}"
}

apply_off() {
    echo off > "$ST/switch"
    res=""
    for id in $IDS; do
        if installed "$id" && [ ! -e "$ADB/modules/$id/disable" ]; then
            if "$KSUD" module disable "$id" >> "$LOGF" 2>&1; then
                : > "$ST/$id.off"
                log "$id: disabled (switch off)"
                res="$res $id:disabled"
            else
                res="$res $id:disable-failed"
            fi
        fi
    done
    sp sys.k4.gmscompat "off${res}"
    log "off:${res}"
}

apply() {
    : > "$LOGF" 2> /dev/null
    if [ ! -f "$KSUD" ]; then
        sp sys.k4.gmscompat none
        log "no KernelSU (no /data/adb/ksud)"
        return
    fi
    if [ -z "$K4GC_NOMAGISK" ] && command -v magisk > /dev/null 2>&1; then
        sp sys.k4.gmscompat magisk
        log "Magisk found, nothing done"
        return
    fi
    if [ "$(gp persist.sys.safemode)" = 1 ] || [ "$(gp ro.sys.safemode)" = 1 ]; then
        sp sys.k4.gmscompat safemode
        log "safe mode boot, nothing done"
        return
    fi
    sw="$(gp $P)"
    if [ ! -d "$ST" ]; then
        mkdir -p "$ST" && chmod 700 "$ST"
        if [ "$sw" = false ]; then
            # set by a build that still had the framework hooks (see the header)
            sp $P true
            sw=true
            log "legacy $P=false from the framework hooks reset to true"
        fi
    fi
    if meta_pending; then
        sp sys.k4.gmscompat wait-meta
        log "a metamodule install is pending: ksud blocks installs until the reboot, tried again then"
        return
    fi
    case "$sw" in
        false | 0) apply_off ;;
        *) apply_on ;;
    esac
}

case "$1" in
    apply) apply ;;
    *) echo "usage: k4-gmscompat apply" >&2; exit 2 ;;
esac
exit 0
