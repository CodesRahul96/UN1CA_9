(type k4_kernel_prop)
(roletype object_r k4_kernel_prop)
(type k4kcheck)
(roletype r k4kcheck)
(allow init k4kcheck (process (transition rlimitinh siginh)))
(dontaudit init k4kcheck (process (noatsecure)))
(allow k4kcheck shell_exec (file (read getattr map execute open entrypoint)))
(allow k4kcheck toolbox_exec (file (read getattr map execute open execute_no_trans)))
(allow k4kcheck system_file (file (read getattr map execute open execute_no_trans)))
(allow k4kcheck proc_version (file (read getattr open)))
(allow k4kcheck proc (file (read getattr open)))
(allow k4kcheck proc_kallsyms (file (read getattr open)))
(allow k4kcheck config_gz (file (read getattr open)))
(allow k4kcheck proc_cgroups (file (read getattr open)))
(allow k4kcheck sysfs (dir (read getattr open search)))
(allow k4kcheck sysfs (file (read getattr open)))
(allow k4kcheck sysfs_btf (dir (getattr search)))
(allow k4kcheck sysfs_btf (file (getattr)))
(allow k4kcheck configfs (dir (getattr search)))
(allow k4kcheck property_socket (sock_file (write)))
(allow k4kcheck init (unix_stream_socket (connectto)))
(allow k4kcheck k4_kernel_prop (property_service (set)))
(allow k4kcheck k4_kernel_prop (file (read getattr map open)))
(allow shell k4_kernel_prop (file (read getattr map open)))
(allow k4kcheck system_prop (file (read getattr map open)))
(allow k4kcheck usb_uvc_enabled_prop (file (read getattr map open)))
